// Reglas de Firestore. Base: copia pegada por Edwin el 2026-10-20 + bloque del modo entrada (2026-10-22).
// Proyecto: action-leaders-plus-8f1b8. Si cambian en la consola, actualizar este archivo.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
       match /users/{socio} {
      allow read: if request.auth != null
        && resource.data.registro.patrocinadorUid == request.auth.uid;
    }
    match /users/{socio} { allow update, delete: if isAdmin(); }
        match /users/{socio} { allow read: if signedIn() && request.auth.uid in resource.data.registro.linea; }
            match /constancia/{uid} { allow read: if signedIn(); allow write: if signedIn() && (request.auth.uid == uid || isAdmin()); }
                  match /perfiles/{code} { allow read: if true; allow write: if signedIn() && request.resource.data.uid == request.auth.uid; }
                  
match /reservas/{id} { allow read: if true; allow create: if request.resource.data.keys().hasOnly(['p','s','t']); allow delete: if signedIn(); }
    match /users/{uid}/prospectos/{id} { allow create: if request.resource.data.keys().hasOnly(['nombre','cc','tel','interes','t','s','tipo']); }



        match /invitaciones/{id} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow update: if signedIn() && (resource.data.by == request.auth.uid || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoPor','usado']));
    }


    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true &&
        request.auth.token.email in ['garciagoedwin@gmail.com','actionleadersoficial@gmail.com','edwing.go@gmail.com'];
    }
    match /team/{doc=**} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /fotos/{id} { allow read: if signedIn(); allow write: if isAdmin() || (signedIn() && id == request.auth.uid); }
    match /perfiles/{code} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
      match /{sub=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
      }
    }
        match /users/{uid}/prospectos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nombre','cc','tel','interes','t'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() < 80
        && request.resource.data.tel is string && request.resource.data.tel.size() < 21;
    }

      // ---- Modo entrada del evento (agregado 2026-10-22) ----
    function staffEvento() { return signedIn() && (isAdmin() || exists(/databases/$(database)/documents/eventoStaff/$(request.auth.uid))); }
    match /eventoStaff/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /evento/{eid} {
      allow read: if signedIn();
      allow write: if staffEvento();
      match /priv/{d} { allow read: if staffEvento(); allow write: if isAdmin(); }
      match /checkin/{id} { allow read, write: if staffEvento(); }
      match /ovr/{id} { allow read: if staffEvento(); allow write: if isAdmin(); }
    }

  }
}

// ===== Agregado el 27/10/2026 (pegado por Edwin después del bloque "Modo entrada", dentro de documents) =====
    // ---- Llamada de 3 ----
    match /llamadas3/{id} {
      allow create: if request.auth != null && request.resource.data.de == request.auth.uid && request.resource.data.para is string;
      allow read: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow update: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid)
        && request.resource.data.de == resource.data.de && request.resource.data.para == resource.data.para;
      allow delete: if request.auth != null && resource.data.de == request.auth.uid;
    }
    // ---- Presentación virtual (sala) ----
    match /users/{uid}/sala/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['n','c','t0','t','pct','r1','pais','pulso','resp','como','motivo','dur'])
        && request.resource.data.n is string && request.resource.data.n.size() <= 60
        && request.resource.data.t is number;
    }
