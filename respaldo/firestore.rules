// Reglas de Firestore. 10/11/2026 SEGURIDAD FASE 1: se quitó la regla duplicada de perfiles (permitía sobrescribir la página de otro socio),
// se quitaron reservas (sin uso) y la regla floja de prospectos, y se validan los campos de la presentación virtual / membresía (sala).
// 10/11/2026 FASE 2: el socio ya no puede cambiarse rango, plan, patrocinador ni línea después de registrarse (solo admin),
// no puede borrar su documento, y la constancia (ranking) solo acepta números dentro de lo posible.
// 10/11/2026 FASE 3: cuentas aprobadas (claim ap del servidor), turnos solo miembros del sistema (claim sis),
// link del grupo del sistema en sisPriv (solo miembros), aprobaciones en aprob/{uid} (patrocinador directo o admin).
// privAp/grupo: link del grupo del equipo, solo cuentas aprobadas.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{socio} {
      allow read: if request.auth != null
        && resource.data.registro.patrocinadorUid == request.auth.uid;
    }
    match /users/{socio} { allow update, delete: if isAdmin(); }
    match /users/{socio} { allow read: if signedIn() && request.auth.uid in resource.data.registro.linea; }
    match /constancia/{uid} {
      allow read: if socio();
      allow write: if isAdmin() || (signedIn() && request.auth.uid == uid && constOk(request.resource.data));
    }
    function nOk(d, k, m) { return !(k in d) || d[k] == null || (d[k] is number && d[k] >= 0 && d[k] <= m); }
    function constOk(d) {
      return nOk(d, 'racha', 31) && nOk(d, 'semDias', 7) && nOk(d, 'semComp', 7) && nOk(d, 'semPts', 35) && nOk(d, 'pSemPts', 35)
        && nOk(d, 'mesDias', 31) && nOk(d, 'mesComp', 31) && nOk(d, 'mesMejor', 31) && nOk(d, 'mesPts', 155)
        && nOk(d, 'semPres', 500) && nOk(d, 'mesPres', 2000) && nOk(d, 'hoy', 100);
    }

    match /invitaciones/{id} {
      allow get: if signedIn();
      allow create: if socio() && request.resource.data.by == request.auth.uid;
      allow update: if signedIn() && (resource.data.by == request.auth.uid || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoPor','usado']));
    }

    function signedIn() { return request.auth != null; }
    // Cuenta aprobada: el servidor marca ap=false a las cuentas en revisión o rechazadas. Sin marca (recién creada) = puede entrar.
    function socio() { return isAdmin() || (signedIn() && request.auth.token.get('ap', true) != false); }
    // Miembro del Sistema de liderazgo (lo marca el servidor desde data/team.json)
    function sis() { return isAdmin() || (signedIn() && request.auth.token.get('sis', false) == true); }
    function sinAp(d) { return !('apE' in d) && !('apT' in d); }
    function sinRegistro(d) { return !('registro' in d) || !('nombre' in d.registro) || d.registro.nombre == ''; }
    function sinRango(d) { return !('registro' in d) || !('rango' in d.registro) || d.registro.rango == ''; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true &&
        request.auth.token.email in ['garciagoedwin@gmail.com','actionleadersoficial@gmail.com','edwing.go@gmail.com'];
    }
    match /team/{doc=**} { allow read: if socio(); allow write: if isAdmin(); }
    match /sisPriv/{d} { allow read: if sis(); allow write: if isAdmin(); }
    // Grupo de WhatsApp del equipo (10 nov): solo cuentas YA aprobadas (sin periodo de gracia) y admins
    // Socios nuevos sin app (10 nov): el patrocinador o los líderes marcan "va a trabajar" o "es cliente". Un socio por cambio.
    match /snvd/{d} {
      allow read: if socio();
      allow create: if socio() && request.resource.data.keys().hasOnly(['c']) && request.resource.data.c.size() == 1;
      allow update: if socio() && request.resource.data.keys().hasOnly(['c'])
        && request.resource.data.c.diff(resource.data.c).affectedKeys().size() == 1;
    }
    match /privAp/{d} { allow read: if isAdmin() || (signedIn() && request.auth.token.get('ap', false) == true); allow write: if isAdmin(); }
    match /aprob/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['ok','por','t'])
        && request.resource.data.ok is bool && request.resource.data.por == request.auth.uid && request.resource.data.t is number
        && (isAdmin() || get(/databases/$(database)/documents/users/$(uid)).data.registro.patrocinadorUid == request.auth.uid);
    }
    match /fotos/{id} { allow read: if signedIn(); allow write: if isAdmin() || (signedIn() && id == request.auth.uid); }
    match /perfiles/{code} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && sinRango(request.resource.data) && sinAp(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['apE','apT']) && (
        sinRegistro(resource.data) ? sinRango(request.resource.data)
        : ('registro' in request.resource.data
           && !request.resource.data.registro.diff(resource.data.registro).affectedKeys()
                .hasAny(['rango','plan','planPor','planCambio','patrocinadorUid','patrocinador','invitadoPor','linea','invId'])));
      allow read: if isAdmin();
      match /{sub=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
      }
    }
    match /users/{uid}/prospectos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nombre','cc','tel','interes','t'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() < 80
        && request.resource.data.tel is string && request.resource.data.tel.size() < 21
        && (!('cc' in request.resource.data) || (request.resource.data.cc is string && request.resource.data.cc.size() <= 5))
        && (!('interes' in request.resource.data) || (request.resource.data.interes is string && request.resource.data.interes.size() <= 60))
        && (!('t' in request.resource.data) || request.resource.data.t is number);
    }

    // ---- Modo entrada del evento ----
    function staffEvento() { return signedIn() && (isAdmin() || exists(/databases/$(database)/documents/eventoStaff/$(request.auth.uid))); }
    match /eventoStaff/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /evento/{eid} {
      allow read: if socio();
      allow write: if staffEvento();
      match /priv/{d} { allow read: if staffEvento(); allow write: if isAdmin(); }
      match /checkin/{id} { allow read, write: if staffEvento(); }
      match /ovr/{id} { allow read: if staffEvento(); allow write: if isAdmin(); }
    }
        // ---- Llamada de 3 ----
    match /llamadas3/{id} {
      allow create: if socio() && request.resource.data.de == request.auth.uid && request.resource.data.para is string;
      allow read: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid);
      allow update: if request.auth != null && (resource.data.de == request.auth.uid || resource.data.para == request.auth.uid)
        && request.resource.data.de == resource.data.de && request.resource.data.para == resource.data.para;
      allow delete: if request.auth != null && resource.data.de == request.auth.uid;
    }
    // ---- Presentación virtual (sala) ----
    match /users/{uid}/sala/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['n','c','t0','t','pct','r1','pais','pulso','resp','como','motivo','dur','w'])
        && request.resource.data.n is string && request.resource.data.n.size() <= 60
        && request.resource.data.t is number
        && txtOk(request.resource.data, 'c', 40) && txtOk(request.resource.data, 'r1', 80) && txtOk(request.resource.data, 'pais', 80)
        && txtOk(request.resource.data, 'pulso', 80) && txtOk(request.resource.data, 'resp', 80) && txtOk(request.resource.data, 'como', 40)
        && txtOk(request.resource.data, 'motivo', 80) && txtOk(request.resource.data, 'w', 20)
        && numOk(request.resource.data, 't0') && numOk(request.resource.data, 'pct') && numOk(request.resource.data, 'dur');
    }
    function txtOk(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function numOk(d, k) { return !(k in d) || d[k] is number; }
    match /agendaEv/{id} {
      allow read: if socio();
      allow create: if socio() && request.resource.data.cre == request.auth.uid;
      allow update: if request.auth != null && (resource.data.cre == request.auth.uid || request.auth.uid in resource.data.lidU || isAdmin())
        && request.resource.data.cre == resource.data.cre;
      allow delete: if request.auth != null && (resource.data.cre == request.auth.uid || isAdmin());
    }
    // ---- Confirmación de asistencia (evento.html) ----
    match /agendaEv/{eid}/rsvp/{rid} {
      allow create: if request.resource.data.keys().hasOnly(['n','w','cc','de','dn','t'])
        && request.resource.data.n is string && request.resource.data.n.size() >= 2 && request.resource.data.n.size() <= 60
        && request.resource.data.w is string && request.resource.data.w.size() >= 7 && request.resource.data.w.size() <= 15
        && request.resource.data.cc is string && request.resource.data.cc.size() <= 4
        && request.resource.data.de is string && request.resource.data.de.size() <= 64
        && request.resource.data.dn is string && request.resource.data.dn.size() <= 60
        && request.resource.data.t is number
        && exists(/databases/$(database)/documents/agendaEv/$(eid));
      allow read: if request.auth != null && (
        resource.data.de == request.auth.uid
        || request.auth.uid == get(/databases/$(database)/documents/agendaEv/$(eid)).data.cre
        || request.auth.uid in get(/databases/$(database)/documents/agendaEv/$(eid)).data.get('lidU', [])
        || request.auth.uid in get(/databases/$(database)/documents/agendaEv/$(eid)).data.get('vL', [])
        || isAdmin());
      allow update, delete: if false;
    }
    // ---- Red de inCruises: cierre de mes (31/10/2026) ----
    match /red/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.ve);
      allow update: if isAdmin() || (signedIn() && request.auth.uid in resource.data.ve
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st']));
      allow create, delete: if isAdmin();
    }
    match /turnos/{mes} {
      allow read: if socio();
      allow write: if sis();
    }
        match /push/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
